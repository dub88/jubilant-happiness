{
  "name": "@plumbline/check",
  "version": "0.1.0",
  "description": "Audit a client website for SEO fundamentals, form spam defences and unfinished content, and report only what a change introduced.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dub88/jubilant-happiness.git",
    "directory": "packages/check"
  },
  "homepage": "https://github.com/dub88/jubilant-happiness#readme",
  "bugs": "https://github.com/dub88/jubilant-happiness/issues",
  "keywords": [
    "seo",
    "audit",
    "site-audit",
    "crawler",
    "lint",
    "open-graph",
    "sitemap",
    "github-action",
    "ci"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "plumbline": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
